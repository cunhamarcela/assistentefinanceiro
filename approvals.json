{
  "version": "1.0.0",
  "project_type": "flutter_firebase",
  "last_updated": "2024-09-17",
  "permissions": {
    "file_operations": {
      "file_read": true,
      "file_write": true,
      "file_delete": false,
      "directory_create": true,
      "directory_delete": false
    },
    "code_operations": {
      "dart_analysis": true,
      "flutter_analyze": true,
      "code_generation": true,
      "build_runner": false,
      "hot_reload": true
    },
    "package_management": {
      "install_packages": false,
      "update_packages": false,
      "remove_packages": false,
      "pubspec_edit": false
    },
    "testing": {
      "run_tests": true,
      "widget_tests": true,
      "integration_tests": false,
      "test_coverage": true
    },
    "database": {
      "firestore_read": true,
      "firestore_write": true,
      "sqlite_operations": true,
      "migration_scripts": false
    },
    "build_config": {
      "android_build": false,
      "ios_build": false,
      "gradle_config": false,
      "podfile_config": false,
      "firebase_config": false
    },
    "security": {
      "keystore_access": false,
      "certificate_access": false,
      "env_variables": false,
      "secure_storage_read": true,
      "secure_storage_write": true
    },
    "external": {
      "network_requests": true,
      "api_calls": true,
      "open_browser": false,
      "system_commands": false
    },
    "development": {
      "debug_mode": true,
      "logging": true,
      "profiling": false,
      "performance_monitoring": true
    }
  },
  "restricted_files": [
    "pubspec.yaml",
    "pubspec.lock",
    "firebase.json",
    "firebase_options.dart",
    "android/app/build.gradle.kts",
    "android/local.properties",
    "ios/Runner/Info.plist",
    "ios/Runner/GoogleService-Info.plist",
