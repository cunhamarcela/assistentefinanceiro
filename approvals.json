    "ios/Runner/*.entitlements",
    "android/app/src/main/AndroidManifest.xml"
  ],
  "auto_approve_patterns": [
    "lib/features/**/presentation/**/*.dart",
    "lib/features/**/domain/**/*.dart",
    "lib/shared/widgets/**/*.dart",
    "lib/core/theme/**/*.dart",
    "lib/core/utils/**/*.dart",
    "test/**/*.dart",
    "assets/**/*"
  ],
  "require_approval_patterns": [
    "lib/core/storage/**/*.dart",
    "lib/core/routes/**/*.dart",
    "lib/features/**/data/datasources/**/*.dart",
    "lib/main.dart",
    "android/**/*",
    "ios/**/*",
    "scripts/**/*"
  ],
  "flutter_specific": {
    "widget_creation": true,
    "state_management": true,
    "navigation": true,
    "theme_modifications": true,
    "asset_management": true,
    "localization": false
