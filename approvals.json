  "getx_specific": {
    "controller_creation": true,
    "binding_creation": true,
    "route_management": false,
    "dependency_injection": true,
    "state_updates": true
  },
  "approval_workflow": {
    "require_explanation": true,
    "require_testing_plan": false,
    "require_rollback_plan": false,
    "auto_approve_minor_changes": true,
    "escalate_security_changes": true
  },
  "notifications": {
    "on_restricted_file_access": true,
    "on_package_changes": true,
    "on_build_config_changes": true,
    "on_security_related_changes": true
  },
  "comments": {
    "project_context": "Assistente Financeiro IA - Flutter app with Firebase backend",
    "architecture": "Clean Architecture + GetX pattern",
    "security_notes": "App handles financial data - extra security measures required",
