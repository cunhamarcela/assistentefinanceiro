rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para dados dos usuários
    match /users/{userId} {
      // Permitir leitura e escrita apenas para o próprio usuário autenticado
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcoleção de despesas
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcoleção de categorias
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcoleção de perfis financeiros
      match /financial_profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcoleção de metas financeiras
      match /financial_goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcoleção de relatórios
      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Regras para dados públicos (se houver)
    match /public/{document=**} {
      allow read: if true;
      allow write: if false; // Apenas administradores podem escrever
    }
    
    // Regras para configurações globais (apenas leitura)
    match /config/{document=**} {
      allow read: if true;
      allow write: if false; // Apenas administradores podem escrever
    }
    
    // Negar acesso a qualquer outro documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
